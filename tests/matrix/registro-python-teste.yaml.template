# ═══════════════════════════════════════════════════════════════════════════
# Matrix Application Service — registro do POP Atende (Python), TEMPLATE de teste
# MX-01 · cópia do registro atual (infra/*-registration.yaml.template) com os
# MESMOS namespaces e TOKENS FICTÍCIOS, renderizada por
# apps/pop-harness/scripts/matrix-dev.sh em diretório fora do git.
#
# Este arquivo não é o registro de produção nem o de dev do POP Atende: é só o
# segundo Application Service do Synapse isolado da MX-01, para provar a
# convivência dos dois registros. Nenhum token real entra aqui.
# ═══════════════════════════════════════════════════════════════════════════
id: popatende-python-teste
# Backend Python na máquina host, por porta alta e IP da LAN (o container não
# alcança 127.0.0.1 do host neste docker rootless). Não precisa estar no ar
# para a MX-01: o Synapse só chama essa URL quando há evento para o AS.
url: "__AS_URL__"
as_token: "__AS_TOKEN__"
hs_token: "__HS_TOKEN__"
rate_limited: false
sender_localpart: wa_as_bot
namespaces:
  users:
    - exclusive: true
      regex: "@wa_.*"
    - exclusive: true
      regex: "@agt_.*"
    - exclusive: true
      regex: "@em_.*"
    - exclusive: true
      regex: "@test_.*"
  aliases:
    - exclusive: true
      regex: "#wa_.*"
    - exclusive: false
      regex: "#dep_.*"
    - exclusive: true
      regex: "#em_.*"
  rooms: []
