# ═══════════════════════════════════════════════════════════════════════════
# Matrix Application Service — NOVO registro do POP Harness (TEMPLATE de teste)
# MX-01 · renderizado por apps/pop-harness/scripts/matrix-dev.sh para um
# diretório de dados FORA do git (padrão ~/.cache/poph-matrix/data).
#
# NUNCA versionar com token real: os placeholders __AS_TOKEN__ e __HS_TOKEN__
# são preenchidos pelo script, a cada execução, com valores fictícios e
# aleatórios; o arquivo renderizado fica com permissão 0600.
#
# Convive com o registro do Python no mesmo Synapse (PRD §12): os namespaces
# são disjuntos — o Python fica com @wa_.*, @agt_.*, @em_.*, @test_* e este
# fica com @ph_.*. O alias #dep_.* é compartilhado (não exclusivo) nos dois,
# igual ao desenho do registro atual.
# ═══════════════════════════════════════════════════════════════════════════
id: poph-matrix-dev
# URL do Harness vista de DENTRO do container. O docker rootless desta estação
# não alcança 127.0.0.1 do host (slirp4netns --disable-host-loopback), por isso
# o script preenche com o IP da LAN e uma porta alta. O caminho /matrix é de
# propósito: a MX-02 valida que o Synapse chama
# <url>/_matrix/app/v1/transactions/{txnId} quando a url tem prefixo.
url: "__AS_URL__"
as_token: "__AS_TOKEN__"
hs_token: "__HS_TOKEN__"
rate_limited: false
sender_localpart: ph_as_bot
namespaces:
  users:
    - exclusive: true
      regex: "@ph_.*"
  aliases:
    - exclusive: true
      regex: "#ph_.*"
    - exclusive: false
      regex: "#dep_.*"
  rooms: []
